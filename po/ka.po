#: src/gstvosk.c:199
msgid "Location (path) of the speech model."
msgstr "საუბრის მოდელის მდებარეობა (ბილიკი)."

#: src/gstvosk.c:203
msgid "Number of alternative results returned."
msgstr "დაბრუნებული ალტერნატიული შედეგების რაოდენობა."

#: src/gstvosk.c:207
msgid "Force the recognizer to return final results."
msgstr "ამომცნობიდან საბოლოო შედეგების ნაძალადევი დაბრუნება."

#: src/gstvosk.c:213
msgid "Performs speech recognition using libvosk"
msgstr "ახდენს საუბრის ამოცნობას ბიბლიოთეკით libvosk"
